# ==========================================
# Classy Crave - Production Environment Variables
# ==========================================

# 1. Database Configuration (Neon PostgreSQL)
# Get this from your Neon dashboard (Settings -> Connection Details -> Pooled connection)
DATABASE_URL="postgresql://user:password@ep-your-db.region.aws.neon.tech/classycrave?sslmode=require"

# 2. Authentication & Security
# Generate a strong random string (e.g., openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-here"

# 3. Application Domain & URLs
# The public-facing URL of your deployed application (e.g., Vercel domain)
NEXT_PUBLIC_APP_URL="https://classycrave.com"

# 4. Storefront Contact Information
# The WhatsApp/Contact number for the restaurant
NEXT_PUBLIC_RESTAURANT_PHONE="923441588883"
